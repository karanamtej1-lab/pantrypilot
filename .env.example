# Copy this file to .env and put your real key(s) there.
# .env is git-ignored; this example file is safe to commit.

# Free AI (used if there's no Anthropic key): https://console.groq.com
GROQ_API_KEY=your_key_here

# Optional, paid: if set, the assistant uses Claude instead of Groq. https://console.anthropic.com
# ANTHROPIC_API_KEY=your_key_here
