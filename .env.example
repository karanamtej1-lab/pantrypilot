# Copy this file to .env and put your real key(s) there.
# .env is git-ignored; this example file is safe to commit. Never put real keys in this file.

# AI for the Ask page (free): Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Or: the publik API (OpenAI-compatible). Get a key at https://publikhq.com/developers
# Keys start with "pk_live_". On Vercel, add the same name under Settings -> Environment Variables.
PUBLIK_API_KEY=your_key_here

# Optional, paid: if set, the assistant uses Claude instead of publik. https://console.anthropic.com
# ANTHROPIC_API_KEY=your_key_here
